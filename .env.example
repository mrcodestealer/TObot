# Copy to .env and fill in real values:
#   cp .env.example .env
# Real .env is NOT in git (secrets). Sync .env to the server separately (scp / copy-paste).

# ================= Lark App (TObot) =================
APP_ID=
APP_SECRET=
VERIFICATION_TOKEN=

# ================= Mailbox =================
# Also accepts osedutybot's MAINTENANCE_MAIL_* names (copy the block as-is).
MAIL_USER=
MAIL_PASSWORD=
MAIL_IMAP_HOST=imap.larksuite.com
MAIL_IMAP_PORT=993
MAIL_IMAP_SSL=1
# Outgoing /reply emails (same account); defaults are fine for Lark mail
# MAIL_SMTP_HOST=smtp.larksuite.com
# MAIL_SMTP_PORT=465

# Folders to index: * = every folder on the server except TOBOT_IMAP_EXCLUDE,
# or a comma-separated list (spaces and Chinese names are OK).
TOBOT_IMAP_FOLDERS=*
# TOBOT_IMAP_EXCLUDE=Spam,Trash,Drafts,Junk,Deleted Messages

# ================= Index tuning (all optional) =================
# TOBOT_WINDOW_DAYS=180           # days of email kept searchable (rolling window, max 365)
# TOBOT_SCAN_INTERVAL_SEC=300     # background re-scan interval
# TOBOT_TZ=Asia/Manila            # timezone for displayed dates
# TOBOT_SCAN_CAP_PER_FOLDER=3000  # max messages listed per folder per scan
# TOBOT_BODY_FETCH_CAP=500        # max NEW full bodies fetched per scan
# TOBOT_MAX_ENTRIES=20000         # hard cap of stored emails
# TOBOT_BODY_MAX_CHARS=6000       # body chars stored per email
# TOBOT_BODY_SHOW_CHARS=3000      # body chars shown in chat
# TOBOT_SEARCH_MAX_RESULTS=10     # max rows in a /search listing
# TOBOT_THREAD_MAX_RESULTS=60     # max emails shown for an exact-title thread
# TOBOT_SHOW_IMAGES=1             # embed inline email images in the card (0 = off)
# ---- /csupdate AI thread review (local Ollama OpenAI endpoint) ----
# CSUPDATE_MODEL=qwen3.6:35b-a3b  # reviewer model (falls back to BOT_CHAT_MODEL)
# CSUPDATE_API_BASE=http://127.0.0.1:11434/v1
# CSUPDATE_TIMEOUT=600            # 35B on CPU can take minutes per thread
# CSUPDATE_REASONING=none         # qwen3.6 needs reasoning_effort=none; 'off' omits the field
# CSUPDATE_STALE_DAYS=2           # newest message older than this → '⚠️ NEEDS UPDATE'
# CSUPDATE_MAX_THREADS=5          # max titles per /csupdate | /searchwithai (slow AI reviews)
# TOBOT_NOAI_MAX_TITLES=20        # max titles per /searchwithoutai (no AI, so much higher)
# CSUPDATE_MAX_IMAGES=4           # biggest N thread images sent to the model
# TOBOT_IMAGES_PER_EMAIL=8        # max images uploaded per email
# TOBOT_IMAGE_MIN_BYTES=2000      # skip images smaller than this (tracking pixels/spacers)
# LARK_DOMAIN=lark                # lark (default) or feishu

# /reply: recipients removed from every reply-all because they bounce ("invalid recipient
# address"). Comma-separated full addresses or @domain entries; overrides the built-in list
# (chabelita.honrada@/operationsupport.team@hotelstotsenberg.com, cxrteam@igo.email).
# TOBOT_REPLY_BLOCKED_RECIPIENTS=chabelita.honrada@hotelstotsenberg.com,operationsupport.team@hotelstotsenberg.com,cxrteam@igo.email

# ================= Self-deploy (/deploy — git pull + systemctl restart) =================
# TOBOT_SERVICE=tobot             # systemd unit restarted by /deploy
# DEPLOY_ALLOWED_OPEN_IDS=        # comma-separated open_ids allowed to /deploy; empty = anyone

# ================= Machine scrape (webmachine.py + smmachine.py, copied from machine bot) =================
# Background loop: warm browser per backend/environment walks EVERY machine in EVERY
# environment (PROD/QAT/UAT) and stores webmachine_data.json. Needs: pip install playwright
# && playwright install chromium. On by default — set WEBMACHINE_SCRAPE=0 to turn it off.
# WEBMACHINE_SCRAPE=1               # 0 disables the scrape loop entirely
# WEBMACHINE_SCRAPE_INTERVAL_SEC=900  # loop interval (min 60s; machine bot ships 60)
# WEBMACHINE_DATA_PATH=             # override webmachine_data.json location
# WEBMACHINE_SITES=                 # default: nwr,nch,tbr,tbp,mdr,dhs,cp,osm,wf
# WEBMACHINE_DEPLOYMENTS=prod,qat,uat
# WEBMACHINE_SCRAPE_CONCURRENCY=8   # parallel backends per pass
# WEBMACHINE_WARM_POOL=1            # keep a logged-in Chromium open per backend (0 = one-shot scrapes; keep 0 on CPU-only hosts)
# WEBMACHINE_WARM_PREWARM_ON_STARTUP=1
# WEBMACHINE_WARM_HEADLESS=1        # REQUIRED on servers without a display: warm browsers are
#                                   # HEADED by default and fail to launch without an X server.
# BOT_PLAYWRIGHT_HEADLESS=1         # headless for ONE-SHOT scrapes only (does not affect the warm pool)

# PROD EGM backend logins. Fallbacks when a site's vars are unset: DHS/NCH fall back to
# NP_BACKEND_*; CP/TBP/MDR/TBR have NO fallback (their scrape fails until set); WF defaults
# to omduty1/omduty1.
NP_BACKEND_USER=
NP_BACKEND_PASSWORD=
DHS_BACKEND_USER=
DHS_BACKEND_PASSWORD=
NCH_BACKEND_USER=
NCH_BACKEND_PASSWORD=
TBP_BACKEND_USER=
TBP_BACKEND_PASSWORD=
CP_BACKEND_USER=
CP_BACKEND_PASSWORD=
TBR_BACKEND_USER=
TBR_BACKEND_PASSWORD=
MDR_BACKEND_USER=
MDR_BACKEND_PASSWORD=
WF_BACKEND_USER=
WF_BACKEND_PASSWORD=

# QAT/UAT osmslot logins (default admin / 123456 when unset).
# WEBMACHINE_OSMSLOT_USER=
# WEBMACHINE_OSMSLOT_PASSWORD=
