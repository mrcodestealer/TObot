# TObot — Lark email-search bot (persistent connection)
# Install on the server:
#   sudo cp /root/TObot/tobot.service /etc/systemd/system/tobot.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tobot.service
# Logs:
#   journalctl -u tobot.service -f

[Unit]
Description=TObot Lark email search bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/TObot
# Needs Python 3.9+. If the system /usr/bin/python3 is older (SyntaxError on
# "from __future__ import annotations"), point ExecStart at the conda python:
#   sed -i "s|ExecStart=.*|ExecStart=$(which python3) /root/TObot/main.py|" /etc/systemd/system/tobot.service
# (run while the (base) conda env is active, then systemctl daemon-reload)
ExecStart=/usr/bin/python3 /root/TObot/main.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
